{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src_new/**/*.ts",
    "tests/run-tests.ts",
    "tests/*src-new*.test.ts",
    "tests/test-workdir.ts",
    "examples/**/*.ts",
    "bin/**/*.ts"
  ]
}
